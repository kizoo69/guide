#!/bin/sh
# Strip AI agent footers and trailing blank lines from commit messages.
# Rules: .ai/git-commits-guidelines.md

perl -i -pe 's/^Co-[Aa]uthored-[Bb]y:.*\n?//;
             s/^Generated with.*\n?//;
             s/^🤖.*\n?//;' "$1"

# Remove trailing blank lines
perl -i -0pe 's/\n+\z/\n/' "$1"
